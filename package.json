{
  "name": "vibetunnel-client",
  "version": "1.0.0",
  "description": "TypeScript client for VibeTunnel - Access your Mac terminal from any browser",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:esbuild": "esbuild src/index.ts --bundle --platform=node --target=node16 --outfile=dist/bundle.js",
    "dev": "npm run build:watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vibetunnel",
    "terminal",
    "ssh",
    "remote",
    "browser",
    "mac",
    "typescript",
    "client"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/username/vibetunnel-client.git"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
